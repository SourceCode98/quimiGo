# Puerto local (Caddy publica el servicio por HTTPS)
PORT=4000
# En la VM de Oracle deja 127.0.0.1 (Caddy publica el servicio). En Render no pongas HOST.
HOST=127.0.0.1
# Secreto para firmar sesiones. Genera uno con: openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-un-secreto-largo
# oracle en producción; memory solo para pruebas locales (se borra al reiniciar)
DB_DRIVER=oracle
ORACLE_USER=QUIMICALEARN
ORACLE_PASSWORD=
# Cadena de conexión TLS de la Autonomous Database (consola de Oracle > Conexión a base de datos > TLS)
ORACLE_CONNECT_STRING=
# production activa cookies seguras (solo HTTPS)
NODE_ENV=production
