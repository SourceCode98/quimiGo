PORT=4000
# Genera uno largo y aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Cadena de conexión de MongoDB Atlas (Connect > Drivers), ej.:
# mongodb+srv://quimicalearn:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Vacía = memoria (solo para pruebas locales; se borra al reiniciar).
MONGODB_URI=
# Cuenta fija de docente: la API la crea (o le cambia la contraseña) cada vez que arranca.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Diego
# true abre el registro de docentes nuevos (por ahora cerrado)
ALLOW_TEACHER_SIGNUP=false
